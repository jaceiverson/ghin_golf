{
  "manifest_version": 3,
  "name": "GHIN-sights",
  "version": "1.2.0",
  "description": "Alternative handicap tables, streaks, and charts for GHIN.com scores, shown in a side panel using your own logged-in session. Help you get more out of the scores you are posting to GHIN.",
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.ghin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open GHIN Tables"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ghin.com/*"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.ghin.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}